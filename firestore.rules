rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email.lower() == 'vasu.kannaluri@gmail.com' ||
        request.auth.token.email.lower() == 'naren.papanaboina@gmail.com'
      );
    }

    // Users Collection
    match /users/{userId} {
      // Users can only read their own profile; admins can read all profiles
      allow read: if isOwner(userId) || isAdmin();
      // Normal users can create their own profile, but cannot self-assign admin role
      allow create: if isOwner(userId) && (
        isAdmin() ||
        !('isAdmin' in request.resource.data) ||
        request.resource.data.isAdmin == false
      );
      // Users can update their own profile, but cannot elevate themselves to admin or change isAdmin
      allow update: if (isOwner(userId) && (
        isAdmin() ||
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin']) ||
        request.resource.data.isAdmin == resource.data.isAdmin
      )) || isAdmin();
      // Only admins can delete profiles
      allow delete: if isAdmin();
    }

    // Listings Collection
    match /listings/{listingId} {
      // Anyone can read active listings
      allow read: if true;
      // Authenticated users can create listings; only admin can create pre-featured listings
      allow create: if isAuthenticated() && (
        isAdmin() ||
        !('featured' in request.resource.data) ||
        request.resource.data.featured == false
      );
      // Seller owner or Admin can update listings; only admins can toggle 'featured'
      allow update: if isAuthenticated() && (
        (request.auth.uid == resource.data.sellerId && (
          isAdmin() ||
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['featured'])
        )) ||
        isAdmin()
      );
      // Seller owner or Admin can delete listings
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.sellerId || isAdmin()
      );
    }

    // Chats Collection
    match /chats/{chatId} {
      allow read, write: if isAuthenticated() && (
        request.auth.uid in resource.data.participants || isAdmin()
      );
      allow create: if isAuthenticated();
    }

    // Reports Collection (Admin-only management)
    match /reports/{reportId} {
      allow create: if isAuthenticated();
      allow read, write: if isAdmin();
    }
  }
}
