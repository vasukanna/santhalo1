rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email.lower() == 'vasu.kannaluri@gmail.com' ||
        request.auth.token.email.lower() == 'naren.papanaboina@gmail.com' ||
        request.auth.token.admin == true
      );
    }

    // Users Collection
    match /users/{userId} {
      // Anyone can read profiles (public marketplace info like seller name/mandal)
      allow read: if true;
      // Users can write their own profile, admins can write any profile
      allow write: if isOwner(userId) || isAdmin();
    }

    // Listings Collection
    match /listings/{listingId} {
      // Anyone can read active listings
      allow read: if true;
      // Authenticated users can create listings
      allow create: if isAuthenticated();
      // Seller owner or Admin can update or delete listings
      allow update, delete: if isAuthenticated() && (
        request.auth.uid == resource.data.sellerId || isAdmin()
      );
    }

    // Chats Collection
    match /chats/{chatId} {
      allow read, write: if isAuthenticated() && (
        request.auth.uid in resource.data.participants || isAdmin()
      );
      allow create: if isAuthenticated();
    }
  }
}
